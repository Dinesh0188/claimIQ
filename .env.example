# Groq is the default. DeepSeek and OpenAI speak the same wire format --
# switching providers means changing these two lines and nothing else.
#
#   Groq      https://api.groq.com/openai/v1
#   DeepSeek  https://api.deepseek.com/v1
#   OpenAI    https://api.openai.com/v1

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here

# Model IDs are verified against the provider's /models endpoint at boot.
# Groq deprecated llama-3.3-70b-versatile and llama-3.1-8b-instant on 2026-06-17,
# so we check rather than trust.
LLM_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.6-27b

# Set false to run the whole app with no LLM at all (deterministic text everywhere).
AI_ENABLED=true
