# Groq is the default. DeepSeek and OpenAI speak the same wire format --
# switching providers means changing these two lines and nothing else.
#
#   Groq      https://api.groq.com/openai/v1
#   DeepSeek  https://api.deepseek.com/v1
#   OpenAI    https://api.openai.com/v1

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here

# Model IDs are verified against the provider's /models endpoint at boot.
# Groq deprecated llama-3.3-70b-versatile and llama-3.1-8b-instant on 2026-06-17,
# so we check rather than trust.
LLM_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.6-27b

# Set false to run the whole app with no LLM at all (deterministic text everywhere).
AI_ENABLED=true


# --- deployment posture ----------------------------------------------------
#
# Every setting below defaults to the single-user local demo, so cloning the repo and
# running .\start.ps1 needs none of them. Turn each on deliberately.

# API keys, as key:tenant:scopes separated by commas. Scopes are read | audit | admin,
# combined with |, and each implies the ones below it. UNSET MEANS AUTHENTICATION IS
# OFF -- which /health states plainly, so an open deployment is never a silent one.
#
#   CLAIMIQ_API_KEYS=k_live_apollo_9f3a2b8c:apollo:audit,k_ro_maxhc_44de:maxhc:read
CLAIMIQ_API_KEYS=

# Browser origins allowed to call the API. Empty means same-origin only, which is
# correct while the SPA is served by this same app. Never set this to *.
CLAIMIQ_CORS_ORIGINS=

# Per-principal request budget over a rolling minute. 0 disables it.
CLAIMIQ_RATE_LIMIT_PER_MINUTE=120

# Upload ceiling, enforced as the bytes arrive rather than after they are buffered.
CLAIMIQ_MAX_UPLOAD_BYTES=26214400

# Batch limits: claims per submission, and how many audit concurrently.
CLAIMIQ_MAX_BATCH_SIZE=500
CLAIMIQ_BATCH_WORKERS=4

# Append-only, hash-chained record of every determination, in data/ledger.db.
# On by default: a claims auditor that cannot say what it decided last Tuesday is
# not one. Set false only if you have another system of record.
CLAIMIQ_LEDGER=true

# One JSON object per line instead of a human-readable log line. Set true in any
# deployment that ships logs somewhere.
CLAIMIQ_JSON_LOGS=false
