# Copy to .env.local for local overrides, or set these directly in the Vercel
# dashboard (Project -> Settings -> Environment Variables) for deployed environments.
#
# Local dev: leave NEXT_PUBLIC_API_URL unset. next.config.js then proxies /api,
# /health and /v1 to BACKEND_URL (defaults to http://localhost:8000), so the browser
# only ever talks to the Next.js origin and CORS never enters the picture locally.

# --- production / preview (Vercel) ---
# Absolute URL of the deployed backend. Once this is set, the frontend calls it
# directly from the browser instead of using the local proxy above -- required in
# production because Vercel's serverless functions cap request bodies well under the
# 25 MB bill upload this app accepts, so uploads cannot be routed through a rewrite.
#
#   NEXT_PUBLIC_API_URL=https://claimiq-api.onrender.com
NEXT_PUBLIC_API_URL=

# --- local dev only ---
# Where next.config.js's rewrite proxy forwards to. Change this if your backend runs
# on a different port or host than the default.
#
#   BACKEND_URL=http://localhost:8000
BACKEND_URL=
